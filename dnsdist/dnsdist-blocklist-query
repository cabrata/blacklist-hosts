#!/usr/bin/env python3
"""
dnsdist-blocklist-query -- explain what the CDB stores say about a domain.

Mirrors what dnsdist does at query time: walk the name from the full qname up
towards the TLD (stopping at 2 labels) and look each candidate up in wire
format. `cdb -q` cannot do this because wire-format keys contain NUL bytes and
so cannot be passed as an argv argument.
"""

import os
import struct
import sys

# Overridable so a freshly built or downloaded CDB can be checked before it is
# installed (build-cdb.yml, dnsdist-blocklist-sync).
BLOCK = os.environ.get("DNSDIST_BLOCK_CDB", "/etc/dnsdist/blocklist.cdb")
ALLOW = os.environ.get("DNSDIST_ALLOW_CDB", "/etc/dnsdist/allowlist.cdb")


def cdb_get(path, key):
    """Minimal constant-database reader (djb cdb format)."""
    try:
        data = open(path, "rb").read()
    except OSError as exc:
        return None, str(exc)

    h = 5381
    for b in key:
        h = ((h * 33) ^ b) & 0xFFFFFFFF

    table = h & 255
    pos, num = struct.unpack("<II", data[table * 8:table * 8 + 8])
    if num == 0:
        return None, None

    slot = (h >> 8) % num
    for i in range(num):
        entry = pos + ((slot + i) % num) * 8
        khash, rec = struct.unpack("<II", data[entry:entry + 8])
        if rec == 0:
            return None, None
        if khash == h:
            klen, vlen = struct.unpack("<II", data[rec:rec + 8])
            if data[rec + 8:rec + 8 + klen] == key:
                start = rec + 8 + klen
                return data[start:start + vlen].decode("utf-8", "replace"), None
    return None, None


def wire(domain):
    out = bytearray()
    for lab in domain.split("."):
        out.append(len(lab))
        out += lab.encode("ascii", "replace")
    out.append(0)
    return bytes(out)


def walk(domain, path, min_labels=2):
    """Yield (candidate, value) for the first suffix present in the store."""
    parts = domain.strip(".").lower().split(".")
    for i in range(len(parts) - min_labels + 1):
        cand = ".".join(parts[i:])
        val, err = cdb_get(path, wire(cand))
        if err:
            return None, None, err
        if val is not None:
            return cand, val, None
    return None, None, None


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: dnsdist-blocklist-query <domain> [domain...]")

    for domain in sys.argv[1:]:
        a_match, a_val, a_err = walk(domain, ALLOW)
        b_match, b_val, b_err = walk(domain, BLOCK)

        if a_err or b_err:
            print("%s: ERROR %s" % (domain, a_err or b_err))
            continue

        if a_match:
            print("%s: ALLOWED (allowlist entry %r from %s)" % (domain, a_match, a_val))
            if b_match:
                print("    note: also on the blocklist via %r (%s), allowlist wins"
                      % (b_match, b_val))
        elif b_match:
            how = "exact match" if b_match == domain.strip(".").lower() else "parent %r" % b_match
            print("%s: BLOCKED (%s, from list %s)" % (domain, how, b_val))
        else:
            print("%s: not filtered" % domain)


if __name__ == "__main__":
    main()
